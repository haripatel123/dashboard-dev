# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ops_dashboard

# GitHub Integration
# Optional for local test/dev (unauthenticated has lower rate limits: 60/hr)
# Recommended: GitHub Personal Access Token (PAT) with read-only public repo scope
GITHUB_TOKEN=

# Repositories to track (comma-separated owner/repo format)
REPOS=facebook/react,vercel/next.js,nodejs/node,vitejs/vite,sveltejs/svelte

# Hourly sync schedule (standard 5-field cron format)
CRON_SCHEDULE=0 * * * *
